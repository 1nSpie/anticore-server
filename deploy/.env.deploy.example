# Какие версии образов запущены. CI сам подставляет их при выкладке.
# Откат: вписать прошлый тег и `docker compose --env-file .env.deploy up -d`.
SERVER_TAG=latest
CLIENT_TAG=latest
# Порт фронта на хосте. Для стенда рядом с продом — другой (например 3100); API-порт задаётся PORT в server.env
CLIENT_PORT=3000
