# server.env — переменные бэка. Лежит на сервере рядом с docker-compose.yml, в git НЕ коммитить.
# Пример составлен по переменным, которые реально читает код (process.env.*).
#
# ВАЖНО: значения пишутся БЕЗ кавычек и без ${...}. Docker не снимает кавычки, в отличие от dotenv:
#   DATABASE_URL="postgresql://..."   ← так нельзя (кавычки станут частью значения)
#   DATABASE_URL=postgresql://...     ← так правильно

# ───── Обязательные ─────

PORT=4444
# Слушать только localhost: API доступен снаружи лишь через nginx, а не напрямую по порту 4444. Рекомендуется на проде.
# Без этой строки бэк слушает на всех интерфейсах.
LISTEN_HOST=127.0.0.1
# Хост БД — localhost, если Postgres стоит на том же сервере (контейнер в network_mode: host)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

# Токены личного кабинета клиентов. Длинная случайная строка: openssl rand -hex 48
JWT_SECRET=

# Вход в админку / CRM
ADMIN_LOGIN=
ADMIN_PASSWORD=
# Отдельный секрет для токенов админки (не равный JWT_SECRET). Не задан — берётся JWT_SECRET и пишется предупреждение.
ADMIN_JWT_SECRET=

# CORS: откуда фронт ходит на API (origin, без слэша на конце)
FRONTEND_BASE_URL=https://example.ru
# Ещё один разрешённый CORS-источник (например, публичный адрес бакета или второй домен). Можно оставить пустым.
SERVER_SELECTEL=

# ───── Интеграции (без них соответствующая функция отключена) ─────

# SMS.ru. Пустой — коды из SMS пишутся в лог, а не отправляются
SMS_RU_API_ID=
# Yandex SmartCaptcha, серверный ключ
SMARTCAPTCHA_SERVER_KEY=
# Заявки в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Заявки в беседу VK
VK_ACCESS_TOKEN=
VK_CHAT_PEER_ID=

# ───── Загрузка фото в Selectel S3 (редакторы блога/работ, фото задач) ─────
# Без ключей загрузка отвечает 503 «Загрузка фотографий ещё не настроена», остальное работает.

S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# По умолчанию ru-3 / https://s3.ru-3.storage.selcloud.ru — менять, только если бакет в другом регионе
# S3_ENDPOINT=
# S3_REGION=
# Публичный адрес бакета без слэша на конце — для ссылок на фото задач (тот же домен, что NEXT_PUBLIC_S3_URL у клиента)
# S3_PUBLIC_URL=
# Папка для файлов админки, по умолчанию admin
# S3_FILES_PREFIX=

# ───── Необязательные ─────

# Домен для cookie, если фронт и API на разных поддоменах (например .example.ru)
# COOKIE_DOMAIN=
# Время жизни токенов ЛК клиента
# CABINET_ACCESS_TTL_SEC=900
# CABINET_REFRESH_TTL_DAYS=7
# CABINET_REFRESH_COOKIE_NAME=cabinet_refresh
# Что показывает GET /api/version
# APP_VERSION=

# Не нужны: NODE_ENV (задан в образе), POSTGRES_* (из них в .env.example только собирается DATABASE_URL),
# CRM_ADMIN_PHONE / CRM_ADMIN_PASSWORD (устаревший модуль, не используется).
