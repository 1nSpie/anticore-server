POSTGRES_USER='USER'
POSTGRES_PASSWORD='PASS'
POSTGRES_HOST='HOST'
POSTGRES_PORT=PORT
POSTGRES_DATABASE='DB'
PORT=PORT
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DATABASE}?schema=public"
FRONTEND_BASE_URL="FRONTEND_BASE_URL"

SERVER_SELECTEL="http://1111111:3000" ## Публичный урл селектел

TELEGRAM_BOT_TOKEN="TOKEN"
TELEGRAM_CHAT_ID="CHADID"

SMS_RU_API_ID=""

JWT_SECRET="change-me"

# Yandex SmartCaptcha — серверный ключ (ysc2_…)
# https://console.yandex.cloud/ → SmartCaptcha
SMARTCAPTCHA_SERVER_KEY=""

# Вход в админку / CRM (POST /api/admin/login)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="change-me"
# Отдельный секрет для токенов админки (обязательно отличный от JWT_SECRET).
# Если не задан — используется JWT_SECRET, в лог пишется предупреждение.
ADMIN_JWT_SECRET=
# Отдельный секрет для токенов сотрудников (ЛК мастера). Без него — JWT_SECRET с предупреждением.
STAFF_JWT_SECRET="change-me-too"

# Не используется (мёртвый модуль crm/auth) — будет удалено вместе с переходом на учётки сотрудников
# Первый администратор CRM (создаётся при старте, если ещё нет)
CRM_ADMIN_PHONE="+79001234567"
CRM_ADMIN_PASSWORD="change-me"

# Файлы админки и кабинета мастера (фото задач) — в ПУБЛИЧНОМ бакете Selectel, в отдельной папке.
# Используются те же S3_BUCKET / S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY / S3_ENDPOINT / S3_REGION, что и для картинок сайта.
# Имя файла — случайный UUID: ссылку нельзя угадать, но любой, у кого она есть, откроет файл. Список файлов бакета должен быть закрыт.
# Публичный адрес бакета для ссылок (без слэша в конце), например https://<id>.selstorage.ru
S3_PUBLIC_URL=
# Папка в бакете (по умолчанию admin). Файлы лежат как <папка>/tasks/<id задачи>/<uuid>.webp
S3_FILES_PREFIX=admin
