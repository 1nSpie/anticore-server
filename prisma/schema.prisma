generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique
  Car  Car[]
}

model Car {
  id             Int             @id @default(autoincrement())
  model          String
  brandId        Int?
  segment        Int
  brand          Brand?          @relation(fields: [brandId], references: [id])
  /**
   * @deprecated legacy single-car slot on CabinetUser — prefer ClientVehicle
   */
  cabinetUsers   CabinetUser[]
  clientVehicles ClientVehicle[]
}

model BodyTypePrice {
  id             Int  @id @default(autoincrement())
  segment        Int  @unique // Ценовой сегмент (1-6)
  standartML     Int?
  standartMLBody Int?
  complexML      Int?
  complexMLBody  Int?
}

model BlogPost {
  id         Int      @id @default(autoincrement())
  title      String
  excerpt    String
  content    Json
  slug       String   @unique
  date       DateTime @default(now())
  readTime   String
  categoryId Int
  image      String?
  author     String   @default("Эксперт Anticore")
  featured   Boolean  @default(false)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category BlogCategory @relation(fields: [categoryId], references: [id])
  tags     BlogTag[]    @relation("BlogPostTags")

  @@map("blog_posts")
}

model BlogCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[] @relation("BlogPostTags")

  @@map("blog_tags")
}

model Work {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  slug        String   @unique
  beforeImage String?
  afterImage  String?
  duration    String // например "6 часов"
  year        String // например "2024"
  carBrand    String // например "Toyota"
  carModel    String // например "Camry 2018"
  categoryId  Int
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category WorkCategory  @relation(fields: [categoryId], references: [id])
  services WorkService[]
  images   WorkImage[]

  @@map("works")
}

model WorkCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  works Work[]

  @@map("work_categories")
}

model WorkService {
  id     Int    @id @default(autoincrement())
  name   String
  workId Int

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@map("work_services")
}

model WorkImage {
  id     Int     @id @default(autoincrement())
  url    String
  alt    String?
  order  Int     @default(0)
  workId Int

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@map("work_images")
}

// --- Личный кабинет (клиенты сайта) ---

enum CabinetUserRole {
  USER
}

enum SmsPurpose {
  PASSWORD_RESET
  PHONE_CHANGE
}

/// Ожидание подтверждения регистрации по SMS
model PendingRegistration {
  id                      Int       @id @default(autoincrement())
  phone                   String    @unique
  passwordHash            String
  code                    String
  expiresAt               DateTime
  privacyPolicyAcceptedAt DateTime?
  personalDataConsentAt   DateTime?
  termsAcceptedAt         DateTime?
  createdAt               DateTime  @default(now())

  @@map("pending_registrations")
}

model CabinetUser {
  id                      Int             @id @default(autoincrement())
  phone                   String          @unique
  passwordHash            String
  firstName               String?
  lastName                String?
  patronymic              String?
  birthDate               DateTime?       @db.Date
  /**
   * Последняя смена даты рождения пользователем (лимит раз в сутки)
   */
  birthDateChangedAt      DateTime?
  /**
   * @deprecated use ClientVehicle — kept synced from primary vehicle
   */
  carId                   Int?
  /**
   * @deprecated use ClientVehicle.customLabel
   */
  customCar               String?         @db.VarChar(200)
  /**
   * @deprecated use ClientVehicle.vin
   */
  vin                     String?         @db.VarChar(17)
  /**
   * Заметки администратора (CRM)
   */
  adminComment            String?         @db.Text
  /**
   * Ссылка на фотоотчёт (Яндекс.Диск), одна на клиента
   */
  photoReportUrl          String?         @db.VarChar(2000)
  phoneVerified           Boolean         @default(false)
  blocked                 Boolean         @default(false)
  blockedAt               DateTime?
  privacyPolicyAcceptedAt DateTime?
  personalDataConsentAt   DateTime?
  termsAcceptedAt         DateTime?
  role                    CabinetUserRole @default(USER)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  car                  Car?                  @relation(fields: [carId], references: [id], onDelete: SetNull)
  vehicles             ClientVehicle[]
  refreshTokens        UserRefreshToken[]
  visits               VisitHistory[]
  documents            UserDocument[]
  payments             PaymentHistory[]
  notificationSettings NotificationSettings?

  @@map("cabinet_users")
}

/**
 * Автомобиль клиента (экземпляр); каталог Car — только марка/модель/сегмент.
 */
model ClientVehicle {
  id          Int       @id @default(autoincrement())
  userId      Int
  carId       Int?
  /**
   * Свободный текст, если авто нет в каталоге
   */
  customLabel String?   @db.VarChar(200)
  vin         String?   @db.VarChar(17)
  /// Год выпуска (обязателен при создании через CRM; у старых записей может быть пуст)
  year        Int?
  /// Государственный номер: заглавные, без пробелов
  plate       String?   @db.VarChar(15)
  isPrimary   Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   CabinetUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  car    Car?           @relation(fields: [carId], references: [id], onDelete: SetNull)
  visits VisitHistory[]

  @@index([userId])
  @@map("client_vehicles")
}

model UserRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_refresh_tokens")
}

model SmsCode {
  id         Int        @id @default(autoincrement())
  phone      String
  purpose    SmsPurpose
  code       String
  userId     Int?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, purpose])
  @@map("sms_codes")
}

model UserDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  fileUrl   String
  createdAt DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_documents")
}

model ServiceType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  visits VisitHistory[]

  @@map("service_types")
}

enum SiteLeadStatus {
  NEW
  /**
   * Админ взял заявку и связывается с клиентом (кнопка «Взять в работу»).
   */
  PROCESSING
  /**
   * Авто на подъёмнике: день записи наступил, запись ещё не закрыта. Ставится автоматически.
   */
  IN_PROGRESS
  NEEDS_CLARIFICATION
  SCHEDULED
  REJECTED
  COMPLETED
}

enum SiteLeadKind {
  CALLBACK
  PRICE_REQUEST
}

model SiteLead {
  id                  Int            @id @default(autoincrement())
  kind                SiteLeadKind   @default(CALLBACK)
  name                String
  phone               String
  message             String?        @db.Text
  carDescription      String?        @db.VarChar(500)
  communicationMethod String?        @db.VarChar(50)
  pageUrl             String?        @db.VarChar(500)
  status              SiteLeadStatus @default(NEW)
  adminNote           String?        @db.Text
  diskLink            String?
  followUpAt          DateTime?
  /**
   * С какого момента считается срок реакции (30 мин): создание или возврат из «На уточнении».
   */
  surfacedAt          DateTime?
  /**
   * Убрана из списка CRM крестиком. Запись остаётся в БД; профиль клиента не затрагивается.
   */
  archivedAt          DateTime?
  /**
   * Город / филиал для записи
   */
  location            CrmLocation?
  visitId             Int?           @unique
  processedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  visit VisitHistory? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("site_leads")
}

model VisitHistory {
  id              Int         @id @default(autoincrement())
  userId          Int
  /**
   * Автомобиль, по которому визит / обслуживание
   */
  vehicleId       Int?
  visitDate       DateTime    @db.Date
  serviceType     String
  diskLink        String?
  startsAt        DateTime?
  endsAt          DateTime?
  priceRub        Int?
  serviceTypeId   Int?
  /**
   * Филиал / площадка записи
   */
  location        CrmLocation @default(ZHUKOVSKY)
  /**
   * Имя менеджера (только админка, не для ЛК)
   */
  managerName     String?     @db.VarChar(100)
  /**
   * Внутренний комментарий мастера к записи.
   */
  masterComment   String?     @db.VarChar(2000)
  reviewSmsSentAt DateTime?
  /**
   * Работы по записи завершены (закрыта из календаря или из заявки).
   */
  completedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user               CabinetUser        @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            ClientVehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  catalogServiceType ServiceType?       @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  pendingReviewSms   PendingReviewSms?
  siteLead           SiteLead?
  assignees          VisitStaff[]
  inspection         VehicleInspection?
  photos             VisitPhoto[]
  /// Единый номер договора и связанных актов (ТЗ §16); выдаётся один раз и не меняется
  docNumber          String?            @unique @db.VarChar(20)
  /// Дата договора — день, когда выдан номер
  docDate            DateTime?
  documents          Document[]
  workItems          VisitWorkItem[]
  handover           VisitHandover?
  /// Скидка: задаётся либо в процентах, либо в рублях (второе значение считается), ТЗ §8.5
  discountPercent    Float?
  discountRub        Int?
  paymentMethod      PaymentMethod?
  /// Фактически полученная оплата
  paidRub            Int?
  /// Мастер-приёмщик записи (сотрудник с ролью ADMIN): ему считается ставка приёмщика
  receiverId         Int?
  receiver           Staff?             @relation("VisitReceiver", fields: [receiverId], references: [id], onDelete: SetNull)
  payrollEntries     PayrollEntry[]
  cashEntries        CashEntry[]
  stockMovements     StockMovement[]

  @@index([location, startsAt])
  @@index([vehicleId])
  @@map("visit_history")
}

enum CrmLocation {
  ZHUKOVSKY
  RAMENSKOYE
  KOLOMNA
}

model PendingReviewSms {
  id      Int          @id @default(autoincrement())
  visitId Int          @unique
  sendAt  DateTime
  sentAt  DateTime?
  visit   VisitHistory @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([sendAt, sentAt])
  @@map("pending_review_sms")
}

model PaymentHistory {
  id           Int      @id @default(autoincrement())
  userId       Int
  amountKopeks Int
  currency     String   @default("RUB")
  description  String
  status       String   @default("completed")
  paidAt       DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_history")
}

model NotificationSettings {
  userId         Int     @id
  smsEnabled     Boolean @default(true)
  notifyReminder Boolean @default(true)

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model AdminAuditLog {
  id           Int      @id @default(autoincrement())
  action       String
  adminSubject String
  targetUserId Int?
  meta         Json?
  createdAt    DateTime @default(now())

  @@map("admin_audit_logs")
}

// --- CRM (внутренняя система автосервиса) ---

model CrmAdmin {
  id           Int      @id @default(autoincrement())
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("crm_admins")
}

enum SmsTemplateKind {
  APPOINTMENT
  REVIEW
  BIRTHDAY
}

model SmsTemplate {
  kind      SmsTemplateKind @id
  body      String          @db.Text
  updatedAt DateTime        @updatedAt

  @@map("sms_templates")
}

model CompanySettings {
  id          Int    @id @default(1)
  companyName String @default("АванКор")

  @@map("company_settings")
}

/// Реквизиты исполнителя (ИП): единственная строка id=1, общая для договора и актов.
model Organization {
  id           Int      @id @default(1)
  /// «ИП Стражников А.Л.»
  fullName     String   @db.VarChar(200)
  /// «АванКор»
  brandName    String   @db.VarChar(100)
  inn          String   @db.VarChar(12)
  ogrnip       String   @db.VarChar(15)
  legalAddress String   @db.VarChar(300)
  phone        String   @db.VarChar(32)
  email        String   @db.VarChar(120)
  /// Подпись в документах: «Стражников А.Л.»
  signerName   String   @db.VarChar(100)
  updatedAt    DateTime @updatedAt

  @@map("organization")
}

/// Филиал для документов: город, адрес и префикс номера. Ключ — тот же `CrmLocation`, что у записи.
model Branch {
  location  CrmLocation @id
  city      String      @db.VarChar(100)
  address   String      @db.VarChar(300)
  /// Префикс номера договора (Ж / Р / К); уникален между филиалами
  docPrefix String      @unique @db.VarChar(4)
  updatedAt DateTime    @updatedAt

  @@map("branches")
}

model SmsLog {
  id      Int      @id @default(autoincrement())
  phone   String
  kind    String
  message String   @db.Text
  sentAt  DateTime @default(now())
  meta    Json?

  @@index([phone, kind, sentAt])
  @@map("sms_logs")
}

/**
 * Лимит записей в календарь на день и филиал.
 */
model CrmDayLimit {
  id              Int         @id @default(autoincrement())
  date            DateTime    @db.Date
  location        CrmLocation
  maxAppointments Int
  note            String?     @db.VarChar(300)
  updatedAt       DateTime    @updatedAt

  @@unique([date, location])
  @@index([location, date])
  @@map("crm_day_limits")
}

enum StaffRole {
  ADMIN
  MASTER
}

/// Сотрудник: мастер (ЛК /staff) или администратор. Env-админ остаётся запасным входом в CRM.
model Staff {
  id                   Int           @id @default(autoincrement())
  login                String        @unique @db.VarChar(64)
  passwordHash         String
  fullName             String        @db.VarChar(120)
  role                 StaffRole     @default(MASTER)
  /// Филиалы, где работает сотрудник
  locations            CrmLocation[]
  blockedAt            DateTime?
  lastLoginAt          DateTime?
  /// Согласие на обработку геолокации (152-ФЗ), даётся мастером один раз перед первым чекином
  geoConsentAt         DateTime?
  /// Версия регламента, с которой мастер ознакомился (0 — не знакомился)
  regulationAckVersion Int           @default(0)
  regulationAckAt      DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  auditLogs           StaffAuditLog[]
  visits              VisitStaff[]
  checkins            Checkin[]
  tasks               Task[]
  notifications       Notification[]
  inspectionsReceived VehicleInspection[]
  workItems           VisitWorkItem[]
  handovers           VisitHandover[]
  receivedVisits      VisitHistory[]      @relation("VisitReceiver")
  payrollEntries      PayrollEntry[]

  @@map("staff")
}

/// Журнал входов и действий сотрудников/админа (ТЗ 6.6).
model StaffAuditLog {
  id        Int      @id @default(autoincrement())
  /// Кто совершил действие; null — env-админ или неизвестный логин
  staffId   Int?
  /// Подпись исполнителя: логин сотрудника или "admin"
  actor     String   @db.VarChar(64)
  action    String   @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(300)
  meta      Json?
  createdAt DateTime @default(now())

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([staffId, createdAt])
  @@index([action, createdAt])
  @@map("staff_audit_logs")
}

/// Назначение мастера на запись: один мастер — несколько записей, несколько мастеров — одна запись.
model VisitStaff {
  id         Int      @id @default(autoincrement())
  visitId    Int
  staffId    Int
  assignedAt DateTime @default(now())

  visit VisitHistory @relation(fields: [visitId], references: [id], onDelete: Cascade)
  staff Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([visitId, staffId])
  @@index([staffId])
  @@map("visit_staff")
}

enum CheckinStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// Чекин = начало смены (один в сутки по Москве). Без подтверждения админом мастер «не на смене».
model Checkin {
  id          Int           @id @default(autoincrement())
  staffId     Int
  /// Московские сутки чекина
  date        DateTime      @db.Date
  location    CrmLocation
  /// Координаты обнуляются через год (срок хранения геоданных)
  lat         Float?
  lng         Float?
  accuracyM   Int?
  distanceM   Int
  /// Вне радиуса филиала — чекин разрешён, но с пометкой
  outOfRadius Boolean       @default(false)
  status      CheckinStatus @default(PENDING)
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([date, location])
  @@map("checkins")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

/// В БД — только рабочий статус. «Просрочена» вычисляется по сроку, «Подтверждена» — по confirmedAt.
enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Задача сотруднику. Создаёт только админ; мастер отмечает «Выполнена», админ подтверждает.
model Task {
  id            Int          @id @default(autoincrement())
  staffId       Int
  title         String       @db.VarChar(200)
  description   String?      @db.VarChar(2000)
  priority      TaskPriority @default(NORMAL)
  status        TaskStatus   @default(NEW)
  dueAt         DateTime?
  /// Комментарий мастера при выполнении
  masterComment String?      @db.VarChar(1000)
  /// Комментарий админа при возврате в работу
  adminComment  String?      @db.VarChar(1000)
  doneAt        DateTime?
  confirmedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  staff  Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  photos TaskPhoto[]

  @@index([staffId, status])
  @@index([dueAt])
  @@map("tasks")
}

/// Единственная строка (id=1): версия регламента. Растёт при каждой публикации — мастера обязаны ознакомиться заново.
model RegulationState {
  id          Int       @id @default(1)
  version     Int       @default(0)
  changeNote  String?   @db.VarChar(1000)
  publishedAt DateTime?
  /// Есть правки, ещё не опубликованные (мастера видят их сразу, но ознакомление не требуется)
  dirty       Boolean   @default(false)

  @@map("regulation_state")
}

/// Раздел регламента; подраздел — раздел с parentId (глубина не больше 2).
model RegSection {
  id        Int      @id @default(autoincrement())
  parentId  Int?
  title     String   @db.VarChar(200)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   RegSection?  @relation("RegSectionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children RegSection[] @relation("RegSectionTree")
  articles RegArticle[]

  @@index([parentId, sortOrder])
  @@map("reg_sections")
}

model RegArticle {
  id        Int      @id @default(autoincrement())
  sectionId Int
  title     String   @db.VarChar(200)
  body      String   @default("") @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section     RegSection      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  attachments RegAttachment[]

  @@index([sectionId, sortOrder])
  @@map("reg_articles")
}

/// PDF-вложение статьи. Хранится в БД и отдаётся только сотрудникам и админу (внутренний документ, не в публичный S3).
model RegAttachment {
  id        Int      @id @default(autoincrement())
  articleId Int
  fileName  String   @db.VarChar(200)
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  article RegArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("reg_attachments")
}

/// Уведомление сотруднику в ЛК (лента + всплывающее окно по WebSocket).
model Notification {
  id        Int       @id @default(autoincrement())
  staffId   Int
  /// TASK_NEW, TASK_RETURNED, TASK_CONFIRMED, SCHEDULE_CHANGED, ASSIGNED, UNASSIGNED, REGULATION, CHECKIN_CONFIRMED, CHECKIN_REJECTED
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  /// Куда вести при нажатии (путь внутри /staff)
  link      String?   @db.VarChar(200)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, readAt, createdAt])
  @@map("notifications")
}

/// Фото к задаче в приватном хранилище Selectel. Объект лежит по `key`, наружу отдаётся только подписанная ссылка.
model TaskPhoto {
  id         Int      @id @default(autoincrement())
  taskId     Int
  /// Ключ объекта в приватном бакете: tasks/{taskId}/{uuid}.webp
  key        String   @unique @db.VarChar(200)
  size       Int
  /// ADMIN — загрузил админ, MASTER — исполнитель
  uploadedBy String   @db.VarChar(10)
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_photos")
}

// --- Приёмка автомобиля (ТЗ «Документооборот», §10, §12) ---

enum DamageType {
  /// X — царапина
  SCRATCH
  /// O — вмятина
  DENT
  /// K — коррозия
  CORROSION
  /// S — скол
  CHIP
  /// D — иное повреждение
  OTHER
}

enum PhotoStage {
  RECEPTION
  WORK_BEFORE
  WORK_AFTER
  ISSUE
}

enum PhotoSection {
  GENERAL
  EXTERIOR
  INTERIOR
}

/// Приёмка конкретного визита: значения этого посещения, история не перезаписывается.
/// Единственный источник данных для акта приёма-передачи.
model VehicleInspection {
  id                 Int       @id @default(autoincrement())
  visitId            Int       @unique
  /// Фактические дата и время приёма (не плановое время записи)
  receivedAt         DateTime
  /// Мастер-приёмщик
  receivedById       Int?
  mileageKm          Int?
  fuelPercent        Int?
  keysCount          Int?
  /// Сотрудник явно подтвердил, что дефектов нет (пустая схема не значит «исправно»)
  noDefectsConfirmed Boolean   @default(false)
  exteriorNote       String?   @db.VarChar(2000)
  /// {dirt, damage, upholstery, smell}: "NONE" | "PRESENT"; null — не заполнено
  interior           Json?
  interiorNote       String?   @db.VarChar(2000)
  /// {lights, turnSignals, brakeLights, wipers, horn, climate, fan, dashboard}: {status: "OK"|"FAULTY"|"NOT_CHECKED", note?}
  systems            Json?
  systemsNote        String?   @db.VarChar(2000)
  /// Индивидуально согласованные особенности приёмки
  specialTerms       String?   @db.VarChar(2000)
  /// Комментарий приёмщика (не внутренняя заметка мастера)
  note               String?   @db.VarChar(2000)
  /// Кто и когда проверил карточку клиента и автомобиля (в т.ч. VIN с маркировкой)
  dataVerifiedAt     DateTime?
  dataVerifiedBy     String?   @db.VarChar(64)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  visit      VisitHistory     @relation(fields: [visitId], references: [id], onDelete: Cascade)
  receivedBy Staff?           @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  marks      InspectionMark[]

  @@map("vehicle_inspections")
}

/// Отметка на схеме автомобиля. Координаты — доли от размера схемы (0..1).
model InspectionMark {
  id           Int        @id @default(autoincrement())
  inspectionId Int
  type         DamageType
  x            Float
  y            Float
  /// Кузовной элемент: «Капот», «Дверь передняя левая» и т.д.
  element      String     @db.VarChar(100)
  note         String?    @db.VarChar(500)
  createdAt    DateTime   @default(now())

  inspection VehicleInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  photos     VisitPhoto[]

  @@index([inspectionId])
  @@map("inspection_marks")
}

/// Фото визита: клиент и автомобиль определяются по записи; этап и (при необходимости) повреждение — здесь.
/// Файл в публичном бакете под случайным UUID (как фото задач).
model VisitPhoto {
  id         Int          @id @default(autoincrement())
  visitId    Int
  stage      PhotoStage   @default(RECEPTION)
  section    PhotoSection @default(GENERAL)
  markId     Int?
  /// Фото «до» и «после» привязано к позиции работ (ТЗ §13.1)
  workItemId Int?
  key        String       @unique @db.VarChar(200)
  size       Int
  uploadedBy String       @db.VarChar(64)
  createdAt  DateTime     @default(now())

  visit    VisitHistory    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  mark     InspectionMark? @relation(fields: [markId], references: [id], onDelete: Cascade)
  workItem VisitWorkItem?  @relation(fields: [workItemId], references: [id], onDelete: Cascade)

  @@index([workItemId])
  @@index([visitId, stage])
  @@index([markId])
  @@map("visit_photos")
}

// --- Документы по записи: номер, версии, снимок данных, подписание (ТЗ §16–18, §23) ---

enum DocumentKind {
  CONTRACT
  ACCEPTANCE
  WORKS
}

enum DocumentVersionStatus {
  /// Сформирован, ждёт подписания
  READY
  SIGNED
  /// Аннулирован или заменён новой версией
  VOID
}

/// Счётчик номеров по префиксу филиала. Растёт атомарно (INSERT … ON CONFLICT DO UPDATE).
model DocumentCounter {
  prefix  String @id @db.VarChar(4)
  lastSeq Int    @default(0)

  @@map("document_counters")
}

/// Документ записи определённого вида; сами данные — в версиях.
model Document {
  id        Int          @id @default(autoincrement())
  visitId   Int
  kind      DocumentKind
  createdAt DateTime     @default(now())

  visit    VisitHistory      @relation(fields: [visitId], references: [id], onDelete: Restrict)
  versions DocumentVersion[]

  @@unique([visitId, kind])
  @@map("documents")
}

/// Версия документа со снимком всех данных на момент формирования. Снимок не меняется никогда:
/// подписанная версия остаётся прежней, даже если потом исправили карточку клиента или автомобиля.
model DocumentVersion {
  id            Int                   @id @default(autoincrement())
  documentId    Int
  version       Int
  status        DocumentVersionStatus @default(READY)
  snapshot      Json
  schemaVersion Int                   @default(1)
  formedAt      DateTime              @default(now())
  formedBy      String                @db.VarChar(64)
  signedAt      DateTime?
  signedBy      String?               @db.VarChar(64)
  /// Скан подписанного документа (публичный бакет, случайное имя)
  scanKey       String?               @db.VarChar(200)
  voidedAt      DateTime?
  voidedBy      String?               @db.VarChar(64)
  voidReason    String?               @db.VarChar(300)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@map("document_versions")
}

// --- Услуги и перечень работ (ТЗ §8.5, §9) ---

enum PaymentMethod {
  CASH
  CARD_SBP
  INVOICE_IP
}

/// Категория услуг: антикоррозийная обработка, сварочные работы, лазерная очистка, мойка днища, диагностика.
model ServiceCategory {
  id        Int     @id @default(autoincrement())
  code      String  @unique @db.VarChar(30)
  name      String  @db.VarChar(120)
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  groups ServiceOptionGroup[]
  items  VisitWorkItem[]

  @@map("service_categories")
}

/// Группа параметров категории («Основные виды», «Зоны автомобиля»…): множественный выбор и/или свой вариант.
model ServiceOptionGroup {
  id          Int     @id @default(autoincrement())
  categoryId  Int
  key         String  @db.VarChar(30)
  label       String  @db.VarChar(120)
  multiple    Boolean @default(true)
  /// Можно ввести значение, которого нет в справочнике
  allowCustom Boolean @default(false)
  sortOrder   Int     @default(0)

  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options  ServiceOption[]

  @@unique([categoryId, key])
  @@map("service_option_groups")
}

/// Значение справочника. Расширяется из админки без правки кода.
model ServiceOption {
  id        Int     @id @default(autoincrement())
  groupId   Int
  name      String  @db.VarChar(100)
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  group ServiceOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, name])
  @@map("service_options")
}

/// Позиция согласованных работ по записи. Значения параметров хранятся текстом (а не ссылками):
/// переименование справочника не меняет уже согласованные работы.
model VisitWorkItem {
  id         Int      @id @default(autoincrement())
  visitId    Int
  categoryId Int
  /// {groupKey: ["Комплексная обработка", ...]}
  selections Json
  comment    String?  @db.VarChar(500)
  /// null — стоимость не определена; 0 — бесплатно (это разные состояния)
  priceRub   Int?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// AGREED — согласовано до работ (договор); EXTRA — дополнительная работа по найденному дефекту (ТЗ §13.2)
  kind            WorkItemKind     @default(AGREED)
  status          WorkStatus       @default(WAITING)
  /// Ответственный мастер
  masterId        Int?
  startedAt       DateTime?
  finishedAt      DateTime?
  /// Фактически выполненный объём
  actualVolume    String?          @db.VarChar(300)
  /// Комментарий мастера по выполнению; для отменённой работы — причина
  workNote        String?          @db.VarChar(500)
  /// Допработа: место обнаруженного дефекта (описание дефекта — в `comment`)
  defectPlace     String?          @db.VarChar(200)
  /// Допработа: предполагаемое изменение срока
  termChangeNote  String?          @db.VarChar(200)
  /// Допработа: согласование с клиентом. Несогласованная не входит в сумму к оплате.
  approvalStatus  ApprovalStatus?
  approvedAt      DateTime?
  /// Кто из сотрудников получил решение клиента
  approvedBy      String?          @db.VarChar(120)
  approvalChannel ApprovalChannel?
  /// Подтверждение (например, «сообщение в WhatsApp от 22.11 14:05»)
  approvalNote    String?          @db.VarChar(300)

  visit    VisitHistory    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  category ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  master   Staff?          @relation(fields: [masterId], references: [id], onDelete: SetNull)
  photos   VisitPhoto[]

  @@index([visitId, sortOrder])
  @@map("visit_work_items")
}

// --- Выполнение работ и выдача автомобиля (ТЗ §13–14) ---

enum WorkItemKind {
  AGREED
  EXTRA
}

enum WorkStatus {
  WAITING
  IN_PROGRESS
  DONE
  PAUSED
  NEEDS_APPROVAL
  /// отменено по согласованию
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalChannel {
  PHONE
  MESSENGER
  EMAIL
  IN_PERSON
  OTHER
}

/// Выдача автомобиля и гарантия. Все значения вносятся явно: гарантийный срок не назначается автоматически,
/// а время выдачи не берётся из предварительной записи (ТЗ §14.6–14.7).
model VisitHandover {
  id                     Int       @id @default(autoincrement())
  visitId                Int       @unique
  /// Фактические дата и время возврата автомобиля
  issuedAt               DateTime?
  issuedById             Int?
  /// Заполняются, только если значение изменилось к выдаче; иначе действуют показатели приёмки
  mileageKm              Int?
  fuelPercent            Int?
  warrantyBookIssued     Boolean?
  warrantyTermsExplained Boolean?
  warrantyMonths         Int?
  warrantyStartsAt       DateTime? @db.Date
  warrantyTerms          String?   @db.VarChar(1000)
  careRecommendations    String?   @db.VarChar(1000)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  visit    VisitHistory @relation(fields: [visitId], references: [id], onDelete: Cascade)
  issuedBy Staff?       @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@map("visit_handovers")
}

// --- Зарплата мастеров и приёмщиков, касса, склад ---

enum PayrollRole {
  MASTER
  RECEIVER
}

/// Единственная строка (id = 1): базовые ставки за заказ, в рублях. Начисление копирует ставку на момент назначения.
model PayrollSettings {
  id              Int      @id @default(1)
  masterBaseRub   Int      @default(0)
  receiverBaseRub Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@map("payroll_settings")
}

/// Справочник доп. выплат («Чистота», «Отзыв» …): сумма и для кого применяется.
model PayrollBonusType {
  id        Int         @id @default(autoincrement())
  title     String      @db.VarChar(80)
  amountRub Int
  role      PayrollRole
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())

  bonuses PayrollBonus[]

  @@map("payroll_bonus_types")
}

/// Начисление сотруднику по записи: ставка зафиксирована при назначении, «начислено» — когда машина закрыта.
model PayrollEntry {
  id        Int         @id @default(autoincrement())
  visitId   Int
  /// null — сотрудник удалён; имя остаётся в `staffName`
  staffId   Int?
  staffName String      @db.VarChar(120)
  role      PayrollRole
  baseRub   Int
  accruedAt DateTime?
  createdAt DateTime    @default(now())

  visit   VisitHistory   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  staff   Staff?         @relation(fields: [staffId], references: [id], onDelete: SetNull)
  bonuses PayrollBonus[]

  @@unique([visitId, staffId, role])
  @@index([staffId, accruedAt])
  @@map("payroll_entries")
}

/// Доп. выплата, отмеченная управляющим; название и сумма копируются из справочника.
model PayrollBonus {
  id        Int      @id @default(autoincrement())
  entryId   Int
  typeId    Int?
  title     String   @db.VarChar(80)
  amountRub Int
  grantedBy String   @db.VarChar(64)
  createdAt DateTime @default(now())

  entry PayrollEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  type  PayrollBonusType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  @@unique([entryId, typeId])
  @@map("payroll_bonuses")
}

enum CashDirection {
  IN
  OUT
}

/// Приход и расход наличных по филиалу. Запись не удаляется, а аннулируется с причиной.
model CashEntry {
  id         Int           @id @default(autoincrement())
  location   CrmLocation
  direction  CashDirection
  amountRub  Int
  category   String?       @db.VarChar(60)
  comment    String?       @db.VarChar(300)
  /// Дата операции по Москве
  date       DateTime      @db.Date
  visitId    Int?
  createdBy  String        @db.VarChar(64)
  createdAt  DateTime      @default(now())
  voidedAt   DateTime?
  voidedBy   String?       @db.VarChar(64)
  voidReason String?       @db.VarChar(300)

  visit VisitHistory? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([location, date])
  @@map("cash_entries")
}

/// Номенклатура склада (материалы, расходники).
model StockItem {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(120)
  unit      String   @db.VarChar(16)
  /// Порог: при остатке ниже на складе показывается предупреждение
  minQty    Decimal  @default(0) @db.Decimal(12, 3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  movements StockMovement[]

  @@map("stock_items")
}

enum StockMoveKind {
  IN
  OUT
  ADJUST
}

/// Движение по складу филиала. `delta` со знаком: приход +, расход −, инвентаризация ±. Остаток = сумма delta.
model StockMovement {
  id        Int           @id @default(autoincrement())
  itemId    Int
  location  CrmLocation
  kind      StockMoveKind
  delta     Decimal       @db.Decimal(12, 3)
  comment   String?       @db.VarChar(300)
  visitId   Int?
  createdBy String        @db.VarChar(64)
  createdAt DateTime      @default(now())

  item  StockItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  visit VisitHistory? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([itemId, location])
  @@map("stock_movements")
}

/// Уведомление администраторам (общая лента: новые заявки и т.п.). Показывается всплывающим окном, колокольчиком и push.
model AdminNotification {
  id        Int       @id @default(autoincrement())
  /// LEAD_NEW
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  /// Куда вести при нажатии (путь внутри /admin)
  link      String?   @db.VarChar(200)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt, createdAt])
  @@map("admin_notifications")
}

/// Подписка браузера на Web Push (устройство администратора).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique @db.Text
  p256dh    String   @db.VarChar(200)
  auth      String   @db.VarChar(100)
  /// `admin` (env-админ) или `staff:<id>` (сотрудник с ролью ADMIN)
  subject   String   @db.VarChar(40)
  createdAt DateTime @default(now())

  @@index([subject])
  @@map("push_subscriptions")
}
