generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique
  Car  Car[]
}

model Car {
  id      Int    @id @default(autoincrement())
  model   String
  brandId Int?
  segment Int
  brand   Brand? @relation(fields: [brandId], references: [id])
  /** @deprecated legacy single-car slot on CabinetUser — prefer ClientVehicle */
  cabinetUsers CabinetUser[]
  clientVehicles ClientVehicle[]
}

model BodyTypePrice {
  id             Int  @id @default(autoincrement())
  segment        Int  @unique // Ценовой сегмент (1-6)
  standartML     Int?
  standartMLBody Int?
  complexML      Int?
  complexMLBody  Int?
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  excerpt   String
  content   Json
  slug      String   @unique
  date      DateTime @default(now())
  readTime  String
  categoryId Int
  image     String?
  author    String   @default("Эксперт Anticore")
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  category BlogCategory @relation(fields: [categoryId], references: [id])
  tags     BlogTag[]    @relation("BlogPostTags")
  
  @@map("blog_posts")
}

model BlogCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  posts BlogPost[]
  
  @@map("blog_categories")
}

model BlogTag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  posts BlogPost[] @relation("BlogPostTags")
  
  @@map("blog_tags")
}

model Work {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  slug          String   @unique
  beforeImage   String?
  afterImage    String?
  duration      String   // например "6 часов"
  year          String   // например "2024"
  carBrand      String   // например "Toyota"
  carModel      String   // например "Camry 2018"
  categoryId    Int
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  category      WorkCategory @relation(fields: [categoryId], references: [id])
  services      WorkService[]
  images        WorkImage[]
  
  @@map("works")
}

model WorkCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  works Work[]
  
  @@map("work_categories")
}

model WorkService {
  id      Int    @id @default(autoincrement())
  name    String
  workId  Int
  
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  @@map("work_services")
}

model WorkImage {
  id       Int    @id @default(autoincrement())
  url      String
  alt      String?
  order    Int    @default(0)
  workId   Int
  
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  @@map("work_images")
}

// --- Личный кабинет (клиенты сайта) ---

enum CabinetUserRole {
  USER
}

enum SmsPurpose {
  PASSWORD_RESET
  PHONE_CHANGE
}

/// Ожидание подтверждения регистрации по SMS
model PendingRegistration {
  id                     Int       @id @default(autoincrement())
  phone                  String    @unique
  passwordHash           String
  code                   String
  expiresAt              DateTime
  privacyPolicyAcceptedAt DateTime?
  personalDataConsentAt  DateTime?
  termsAcceptedAt        DateTime?
  createdAt              DateTime  @default(now())

  @@map("pending_registrations")
}

model CabinetUser {
  id            Int       @id @default(autoincrement())
  phone         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  patronymic    String?
  birthDate           DateTime? @db.Date
  /** Последняя смена даты рождения пользователем (лимит раз в сутки) */
  birthDateChangedAt  DateTime?
  /** @deprecated use ClientVehicle — kept synced from primary vehicle */
  carId               Int?
  /** @deprecated use ClientVehicle.customLabel */
  customCar     String?   @db.VarChar(200)
  /** @deprecated use ClientVehicle.vin */
  vin             String?   @db.VarChar(17)
  /** Заметки администратора (CRM) */
  adminComment    String?   @db.Text
  /** Ссылка на фотоотчёт (Яндекс.Диск), одна на клиента */
  photoReportUrl  String?   @db.VarChar(2000)
  phoneVerified Boolean   @default(false)
  blocked       Boolean   @default(false)
  blockedAt     DateTime?
  privacyPolicyAcceptedAt DateTime?
  personalDataConsentAt   DateTime?
  termsAcceptedAt         DateTime?
  role          CabinetUserRole @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  car                   Car?                 @relation(fields: [carId], references: [id], onDelete: SetNull)
  vehicles              ClientVehicle[]
  refreshTokens         UserRefreshToken[]
  visits                VisitHistory[]
  documents             UserDocument[]
  payments              PaymentHistory[]
  notificationSettings  NotificationSettings?

  @@map("cabinet_users")
}

/** Автомобиль клиента (экземпляр); каталог Car — только марка/модель/сегмент. */
model ClientVehicle {
  id          Int       @id @default(autoincrement())
  userId      Int
  carId       Int?
  /** Свободный текст, если авто нет в каталоге */
  customLabel String?   @db.VarChar(200)
  vin         String?   @db.VarChar(17)
  isPrimary   Boolean   @default(false)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   CabinetUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  car    Car?           @relation(fields: [carId], references: [id], onDelete: SetNull)
  visits VisitHistory[]

  @@index([userId])
  @@map("client_vehicles")
}

model UserRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_refresh_tokens")
}

model SmsCode {
  id         Int       @id @default(autoincrement())
  phone      String
  purpose    SmsPurpose
  code       String
  userId     Int?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
  @@map("sms_codes")
}

model UserDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  fileUrl   String
  createdAt DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_documents")
}

model ServiceType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  visits VisitHistory[]

  @@map("service_types")
}

enum SiteLeadStatus {
  NEW
  /** Админ взял заявку и связывается с клиентом (кнопка «Взять в работу»). */
  PROCESSING
  /** Авто на подъёмнике: день записи наступил, запись ещё не закрыта. Ставится автоматически. */
  IN_PROGRESS
  NEEDS_CLARIFICATION
  SCHEDULED
  REJECTED
  COMPLETED
}

enum SiteLeadKind {
  CALLBACK
  PRICE_REQUEST
}

model SiteLead {
  id                  Int            @id @default(autoincrement())
  kind                SiteLeadKind   @default(CALLBACK)
  name                String
  phone               String
  message             String?        @db.Text
  carDescription      String?        @db.VarChar(500)
  communicationMethod String?        @db.VarChar(50)
  pageUrl             String?        @db.VarChar(500)
  status              SiteLeadStatus @default(NEW)
  adminNote           String?        @db.Text
  diskLink            String?
  followUpAt          DateTime?
  /** С какого момента считается срок реакции (30 мин): создание или возврат из «На уточнении». */
  surfacedAt          DateTime?
  /** Убрана из списка CRM крестиком. Запись остаётся в БД; профиль клиента не затрагивается. */
  archivedAt          DateTime?
  /** Город / филиал для записи */
  location            CrmLocation?
  visitId             Int?           @unique
  processedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  visit VisitHistory? @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("site_leads")
}

model VisitHistory {
  id              Int       @id @default(autoincrement())
  userId          Int
  /** Автомобиль, по которому визит / обслуживание */
  vehicleId       Int?
  visitDate       DateTime  @db.Date
  serviceType     String
  diskLink        String?
  startsAt        DateTime?
  endsAt          DateTime?
  priceRub        Int?
  serviceTypeId   Int?
  /** Филиал / площадка записи */
  location        CrmLocation @default(ZHUKOVSKY)
  /** Имя менеджера (только админка, не для ЛК) */
  managerName     String?   @db.VarChar(100)
  /** Внутренний комментарий мастера к записи. */
  masterComment   String?   @db.VarChar(2000)
  reviewSmsSentAt DateTime?
  /** Работы по записи завершены (закрыта из календаря или из заявки). */
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user               CabinetUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle            ClientVehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  catalogServiceType ServiceType?      @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)
  pendingReviewSms   PendingReviewSms?
  siteLead           SiteLead?
  assignees          VisitStaff[]

  @@index([location, startsAt])
  @@index([vehicleId])
  @@map("visit_history")
}

enum CrmLocation {
  ZHUKOVSKY
  RAMENSKOYE
  KOLOMNA
}

model PendingReviewSms {
  id      Int       @id @default(autoincrement())
  visitId Int       @unique
  sendAt  DateTime
  sentAt  DateTime?
  visit   VisitHistory @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([sendAt, sentAt])
  @@map("pending_review_sms")
}

model PaymentHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  amountKopeks Int
  currency    String   @default("RUB")
  description String
  status      String   @default("completed")
  paidAt      DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_history")
}

model NotificationSettings {
  userId         Int     @id
  smsEnabled     Boolean @default(true)
  notifyReminder Boolean @default(true)

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model AdminAuditLog {
  id             Int      @id @default(autoincrement())
  action         String
  adminSubject   String
  targetUserId   Int?
  meta           Json?
  createdAt      DateTime @default(now())

  @@map("admin_audit_logs")
}

// --- CRM (внутренняя система автосервиса) ---

model CrmAdmin {
  id           Int      @id @default(autoincrement())
  phone        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("crm_admins")
}

enum SmsTemplateKind {
  APPOINTMENT
  REVIEW
  BIRTHDAY
}

model SmsTemplate {
  kind      SmsTemplateKind @id
  body      String          @db.Text
  updatedAt DateTime        @updatedAt

  @@map("sms_templates")
}

model CompanySettings {
  id          Int    @id @default(1)
  companyName String @default("АванКор")

  @@map("company_settings")
}

model SmsLog {
  id      Int      @id @default(autoincrement())
  phone   String
  kind    String
  message String   @db.Text
  sentAt  DateTime @default(now())
  meta    Json?

  @@index([phone, kind, sentAt])
  @@map("sms_logs")
}

/** Лимит записей в календарь на день и филиал. */
model CrmDayLimit {
  id               Int         @id @default(autoincrement())
  date             DateTime    @db.Date
  location         CrmLocation
  maxAppointments  Int
  note             String?     @db.VarChar(300)
  updatedAt        DateTime    @updatedAt

  @@unique([date, location])
  @@index([location, date])
  @@map("crm_day_limits")
}

enum StaffRole {
  ADMIN
  MASTER
}

/// Сотрудник: мастер (ЛК /staff) или администратор. Env-админ остаётся запасным входом в CRM.
model Staff {
  id           Int           @id @default(autoincrement())
  login        String        @unique @db.VarChar(64)
  passwordHash String
  fullName     String        @db.VarChar(120)
  role         StaffRole     @default(MASTER)
  /// Филиалы, где работает сотрудник
  locations    CrmLocation[]
  blockedAt    DateTime?
  lastLoginAt  DateTime?
  /// Согласие на обработку геолокации (152-ФЗ), даётся мастером один раз перед первым чекином
  geoConsentAt DateTime?
  /// Версия регламента, с которой мастер ознакомился (0 — не знакомился)
  regulationAckVersion Int       @default(0)
  regulationAckAt      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  auditLogs StaffAuditLog[]
  visits    VisitStaff[]
  checkins  Checkin[]
  tasks     Task[]
  notifications Notification[]

  @@map("staff")
}

/// Журнал входов и действий сотрудников/админа (ТЗ 6.6).
model StaffAuditLog {
  id        Int      @id @default(autoincrement())
  /// Кто совершил действие; null — env-админ или неизвестный логин
  staffId   Int?
  /// Подпись исполнителя: логин сотрудника или "admin"
  actor     String   @db.VarChar(64)
  action    String   @db.VarChar(64)
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(300)
  meta      Json?
  createdAt DateTime @default(now())

  staff Staff? @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([staffId, createdAt])
  @@index([action, createdAt])
  @@map("staff_audit_logs")
}

/// Назначение мастера на запись: один мастер — несколько записей, несколько мастеров — одна запись.
model VisitStaff {
  id         Int      @id @default(autoincrement())
  visitId    Int
  staffId    Int
  assignedAt DateTime @default(now())

  visit VisitHistory @relation(fields: [visitId], references: [id], onDelete: Cascade)
  staff Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([visitId, staffId])
  @@index([staffId])
  @@map("visit_staff")
}

enum CheckinStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// Чекин = начало смены (один в сутки по Москве). Без подтверждения админом мастер «не на смене».
model Checkin {
  id          Int           @id @default(autoincrement())
  staffId     Int
  /// Московские сутки чекина
  date        DateTime      @db.Date
  location    CrmLocation
  /// Координаты обнуляются через год (срок хранения геоданных)
  lat         Float?
  lng         Float?
  accuracyM   Int?
  distanceM   Int
  /// Вне радиуса филиала — чекин разрешён, но с пометкой
  outOfRadius Boolean       @default(false)
  status      CheckinStatus @default(PENDING)
  decidedAt   DateTime?
  createdAt   DateTime      @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([date, location])
  @@map("checkins")
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

/// В БД — только рабочий статус. «Просрочена» вычисляется по сроку, «Подтверждена» — по confirmedAt.
enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

/// Задача сотруднику. Создаёт только админ; мастер отмечает «Выполнена», админ подтверждает.
model Task {
  id           Int          @id @default(autoincrement())
  staffId      Int
  title        String       @db.VarChar(200)
  description  String?      @db.VarChar(2000)
  priority     TaskPriority @default(NORMAL)
  status       TaskStatus   @default(NEW)
  dueAt        DateTime?
  /// Комментарий мастера при выполнении
  masterComment String?     @db.VarChar(1000)
  /// Комментарий админа при возврате в работу
  adminComment String?      @db.VarChar(1000)
  doneAt       DateTime?
  confirmedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  staff  Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  photos TaskPhoto[]

  @@index([staffId, status])
  @@index([dueAt])
  @@map("tasks")
}

/// Единственная строка (id=1): версия регламента. Растёт при каждой публикации — мастера обязаны ознакомиться заново.
model RegulationState {
  id          Int       @id @default(1)
  version     Int       @default(0)
  changeNote  String?   @db.VarChar(1000)
  publishedAt DateTime?
  /// Есть правки, ещё не опубликованные (мастера видят их сразу, но ознакомление не требуется)
  dirty       Boolean   @default(false)

  @@map("regulation_state")
}

/// Раздел регламента; подраздел — раздел с parentId (глубина не больше 2).
model RegSection {
  id        Int      @id @default(autoincrement())
  parentId  Int?
  title     String   @db.VarChar(200)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   RegSection?  @relation("RegSectionTree", fields: [parentId], references: [id], onDelete: Restrict)
  children RegSection[] @relation("RegSectionTree")
  articles RegArticle[]

  @@index([parentId, sortOrder])
  @@map("reg_sections")
}

model RegArticle {
  id        Int      @id @default(autoincrement())
  sectionId Int
  title     String   @db.VarChar(200)
  body      String   @default("") @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section     RegSection      @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  attachments RegAttachment[]

  @@index([sectionId, sortOrder])
  @@map("reg_articles")
}

/// PDF-вложение статьи. Хранится в БД и отдаётся только сотрудникам и админу (внутренний документ, не в публичный S3).
model RegAttachment {
  id        Int      @id @default(autoincrement())
  articleId Int
  fileName  String   @db.VarChar(200)
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  article RegArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("reg_attachments")
}

/// Уведомление сотруднику в ЛК (лента + всплывающее окно по WebSocket).
model Notification {
  id        Int       @id @default(autoincrement())
  staffId   Int
  /// TASK_NEW, TASK_RETURNED, TASK_CONFIRMED, SCHEDULE_CHANGED, ASSIGNED, UNASSIGNED, REGULATION, CHECKIN_CONFIRMED, CHECKIN_REJECTED
  type      String    @db.VarChar(40)
  title     String    @db.VarChar(200)
  body      String?   @db.VarChar(500)
  /// Куда вести при нажатии (путь внутри /staff)
  link      String?   @db.VarChar(200)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, readAt, createdAt])
  @@map("notifications")
}

/// Фото к задаче в приватном хранилище Selectel. Объект лежит по `key`, наружу отдаётся только подписанная ссылка.
model TaskPhoto {
  id         Int      @id @default(autoincrement())
  taskId     Int
  /// Ключ объекта в приватном бакете: tasks/{taskId}/{uuid}.webp
  key        String   @unique @db.VarChar(200)
  size       Int
  /// ADMIN — загрузил админ, MASTER — исполнитель
  uploadedBy String   @db.VarChar(10)
  createdAt  DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_photos")
}
