generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id   Int    @id @default(autoincrement())
  name String @unique
  Car  Car[]
}

model Car {
  id      Int    @id @default(autoincrement())
  model   String
  brandId Int?
  segment Int
  brand   Brand? @relation(fields: [brandId], references: [id])
  cabinetUsers CabinetUser[]
}

model BodyTypePrice {
  id             Int  @id @default(autoincrement())
  segment        Int  @unique // Ценовой сегмент (1-6)
  standartML     Int?
  standartMLBody Int?
  complexML      Int?
  complexMLBody  Int?
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  excerpt   String
  content   Json
  slug      String   @unique
  date      DateTime @default(now())
  readTime  String
  categoryId Int
  image     String?
  author    String   @default("Эксперт Anticore")
  featured  Boolean  @default(false)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  category BlogCategory @relation(fields: [categoryId], references: [id])
  tags     BlogTag[]    @relation("BlogPostTags")
  
  @@map("blog_posts")
}

model BlogCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  posts BlogPost[]
  
  @@map("blog_categories")
}

model BlogTag {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  slug      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  posts BlogPost[] @relation("BlogPostTags")
  
  @@map("blog_tags")
}

model Work {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  slug          String   @unique
  beforeImage   String?
  afterImage    String?
  duration      String   // например "6 часов"
  year          String   // например "2024"
  carBrand      String   // например "Toyota"
  carModel      String   // например "Camry 2018"
  categoryId    Int
  featured      Boolean  @default(false)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  category      WorkCategory @relation(fields: [categoryId], references: [id])
  services      WorkService[]
  images        WorkImage[]
  
  @@map("works")
}

model WorkCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  works Work[]
  
  @@map("work_categories")
}

model WorkService {
  id      Int    @id @default(autoincrement())
  name    String
  workId  Int
  
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  @@map("work_services")
}

model WorkImage {
  id       Int    @id @default(autoincrement())
  url      String
  alt      String?
  order    Int    @default(0)
  workId   Int
  
  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  
  @@map("work_images")
}

// --- Личный кабинет (клиенты сайта) ---

enum CabinetUserRole {
  USER
}

enum SmsPurpose {
  PASSWORD_RESET
  PHONE_CHANGE
}

/// Ожидание подтверждения регистрации по SMS
model PendingRegistration {
  id                     Int       @id @default(autoincrement())
  phone                  String    @unique
  passwordHash           String
  code                   String
  expiresAt              DateTime
  privacyPolicyAcceptedAt DateTime?
  personalDataConsentAt  DateTime?
  termsAcceptedAt        DateTime?
  createdAt              DateTime  @default(now())

  @@map("pending_registrations")
}

model CabinetUser {
  id            Int       @id @default(autoincrement())
  phone         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  patronymic    String?
  birthDate           DateTime? @db.Date
  /** Последняя смена даты рождения пользователем (лимит раз в сутки) */
  birthDateChangedAt  DateTime?
  carId               Int?
  /** Свободный текст, если авто нет в каталоге */
  customCar     String?   @db.VarChar(200)
  phoneVerified Boolean   @default(false)
  blocked       Boolean   @default(false)
  blockedAt     DateTime?
  privacyPolicyAcceptedAt DateTime?
  personalDataConsentAt   DateTime?
  termsAcceptedAt         DateTime?
  role          CabinetUserRole @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  car                   Car?                 @relation(fields: [carId], references: [id], onDelete: SetNull)
  refreshTokens         UserRefreshToken[]
  visits                VisitHistory[]
  documents             UserDocument[]
  payments              PaymentHistory[]
  notificationSettings  NotificationSettings?

  @@map("cabinet_users")
}

model UserRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_refresh_tokens")
}

model SmsCode {
  id         Int       @id @default(autoincrement())
  phone      String
  purpose    SmsPurpose
  code       String
  userId     Int?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
  @@map("sms_codes")
}

model UserDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  fileUrl   String
  createdAt DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_documents")
}

model VisitHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  visitDate   DateTime @db.Date
  serviceType String
  diskLink    String?
  createdAt   DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("visit_history")
}

model PaymentHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  amountKopeks Int
  currency    String   @default("RUB")
  description String
  status      String   @default("completed")
  paidAt      DateTime @default(now())

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_history")
}

model NotificationSettings {
  userId         Int     @id
  smsEnabled     Boolean @default(true)
  notifyReminder Boolean @default(true)

  user CabinetUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model AdminAuditLog {
  id             Int      @id @default(autoincrement())
  action         String
  adminSubject   String
  targetUserId   Int?
  meta           Json?
  createdAt      DateTime @default(now())

  @@map("admin_audit_logs")
}
